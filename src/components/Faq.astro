---
interface Item {
  question: string;
  answer: string;
}

interface Props {
  title?: string;
  items: Item[];
}

const { title = 'Preguntas frecuentes', items } = Astro.props;
---

<section class="mx-auto max-w-4xl px-4 py-16">
  <h2 class="font-display text-3xl font-bold">{title}</h2>
  <div class="mt-8 space-y-3">
    {
      items.map((item) => (
        <details class="wow-card group rounded-xl border border-line bg-panel p-5">
          <summary class="cursor-pointer list-none font-semibold text-paper marker:content-none">
            {item.question}
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-mist">{item.answer}</p>
        </details>
      ))
    }
  </div>
</section>

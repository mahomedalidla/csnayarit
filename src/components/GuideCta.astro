---
import { site, whatsappUrl } from '../config/site';

interface Props {
  text: string;
  message: string;
  label?: string;
}

const { text, message, label = `WhatsApp · ${site.telephoneDisplay}` } = Astro.props;
---

<aside class="my-10 rounded-2xl border border-signal/40 bg-gradient-to-br from-signal/15 to-panel p-6 sm:flex sm:items-center sm:justify-between sm:gap-8">
  <p class="text-base leading-relaxed text-paper">{text}</p>
  <a
    href={whatsappUrl(message)}
    class="cta-pulse glow-signal mt-5 inline-flex shrink-0 items-center justify-center rounded-full bg-signal px-5 py-3 text-sm font-semibold text-ink hover:bg-signal-dark sm:mt-0"
  >
    {label}
  </a>
</aside>

---
import JsonLd from '../components/JsonLd.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import '../styles/global.css';
import {
  site,
  canonical,
  organizationNode,
  serviceCatalogNode,
  websiteNode,
  breadcrumbNode,
  type JsonLdNode,
} from '../config/site';

interface Props {
  title: string;
  description: string;
  path: string;
  breadcrumbs?: { name: string; path: string }[];
  schema?: JsonLdNode[];
  noindex?: boolean;
}

const { title, description, path, breadcrumbs = [], schema = [], noindex = false } = Astro.props;
const gtmScript = `(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-N2ZL5TQP');`;
const adsScript = `window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', 'AW-18529724524');`;
const url = canonical(path);
const graph: JsonLdNode[] = [
  organizationNode(),
  websiteNode(),
  serviceCatalogNode(),
  ...(breadcrumbs.length ? [breadcrumbNode(breadcrumbs)] : []),
  ...schema,
];
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <!-- Google Tag Manager -->
    <script is:inline set:html={gtmScript}></script>
    <!-- End Google Tag Manager -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Google tag (gtag.js) — Google Ads -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18529724524" is:inline></script>
    <script is:inline set:html={adsScript}></script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta
      name="robots"
      content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1'}
    />
    <meta name="author" content={site.name} />
    <meta name="geo.region" content="MX-NAY" />
    <meta name="geo.placename" content="Tepic, Nayarit" />
    <meta name="geo.position" content={`${site.geo.latitude};${site.geo.longitude}`} />
    <meta name="ICBM" content={`${site.geo.latitude}, ${site.geo.longitude}`} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={canonical(site.image)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={canonical(site.image)} />
    <JsonLd graph={graph} />
  </head>
  <body class="min-h-screen bg-ink text-paper antialiased">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-N2ZL5TQP"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-signal focus:px-3 focus:py-2 focus:text-ink"
    >
      Saltar al contenido
    </a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />
  </body>
</html>
